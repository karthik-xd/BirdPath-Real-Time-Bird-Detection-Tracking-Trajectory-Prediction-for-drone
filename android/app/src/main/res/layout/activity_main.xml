<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <!-- Layer 1: Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layers 2 & 3: Transparent Overlay View for Boxes & Trajectory Curves -->
    <com.birdpath.app.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Action Bar / Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Record Button -->
        <Button
            android:id="@+id/btnRecord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_record"
            android:backgroundTint="@color/recording_red"
            android:textColor="@color/white" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Settings Button -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_settings"
            android:backgroundTint="@color/hud_background"
            android:textColor="@color/white" />
    </LinearLayout>

    <!-- Bottom Debug HUD Panel -->
    <LinearLayout
        android:id="@+id/debugHudPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:background="@color/hud_background"
        android:padding="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FPS: --"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvInferenceLatency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inference: -- ms"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvDelegate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Backend: GPU"
            android:textColor="@color/teal_200"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvTracksCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active Tracks: 0"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:fontFamily="monospace" />
    </LinearLayout>

</FrameLayout>
